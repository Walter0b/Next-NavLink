{
  "name": "next-navlink",
  "version": "2.0.0",
  "description": "A NavLink component for Next.js: active-state detection, match modes, external links and accessibility support.",
  "keywords": [
    "nextjs",
    "next",
    "navigation",
    "navlink",
    "nav-link",
    "active-link",
    "react",
    "link",
    "app-router"
  ],
  "homepage": "https://github.com/Walter0b/Next-NavLink#readme",
  "bugs": {
    "url": "https://github.com/Walter0b/Next-NavLink/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Walter0b/Next-NavLink.git"
  },
  "license": "MIT",
  "author": "WalterOb",
  "sideEffects": false,
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:package": "node scripts/check-dist.mjs && publint && attw --pack . --profile node16",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "next": "^13.4.0 || ^14.0.0 || ^15.0.0 || ^16.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^27.0.0",
    "next": "^16.0.0",
    "publint": "^0.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
